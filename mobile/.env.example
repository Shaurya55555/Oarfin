# Oarfin server the app talks to. Defaults to the deployed server when unset.
# For a server running on your computer, use your computer's LAN IP (not localhost),
# because the app runs on your phone:  EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://oarfin-server.onrender.com
